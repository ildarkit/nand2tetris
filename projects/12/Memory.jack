/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */ 
class Memory {
    static Array memory;
    static int freeList;

    /** Initializes the class. */
    function void init() {
      let memory = 0;
      let freeList = 2048;
      let memory[freeList] = 0;
      let memory[freeList + 1] = 14336; // size of heap
      return;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
      return memory[address];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
      let memory[address] = value;
      return;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. */
    function int alloc(int size) {
      var int segment, totalSize, segmentSize, nextAddr;
      var boolean isAllocated;

      let segment = freeList;
      let totalSize = size + 2;
      let nextAddr = 0;
      let isAllocated = false;

      while (~(isAllocated | (memory[segment] = 0))) {
        let segmentSize = memory[segment + 1];
        if ((segmentSize = totalSize) | (segmentSize > totalSize)) {
          let memory[segment + 1] = segmentSize - totalSize;
          let nextAddr = segment + memory[segment + 1];
          let memory[nextAddr + 1] = totalSize;
          let isAllocated = true;
        }
        let segment = memory[segment];
      }

      if (memory[segment] = 0 & (~isAllocated)) {
        let segmentSize = memory[segment + 1];
        let memory[segment + 1] = segmentSize - totalSize;
        let nextAddr = segment + segmentSize;
        let memory[segment] = nextAddr;
        let memory[nextAddr + 1] = totalSize;
        let isAllocated = true;
      }

      if (isAllocated) {
        return nextAddr + 2;
      }
      return -1;
    }

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array object) {
      var int segment;
      var int nextAddr;

      let segment = object - 2;
      let memory[segment] = 0;
      let nextAddr = freeList;

      while (~(memory[nextAddr] = 0)) {
        let nextAddr = memory[nextAddr];
      }

      let memory[nextAddr] = segment;
      return;
    }  
}
